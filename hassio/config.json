{
  "name": "HiSense Air Conditioners (Schimmelreiter)",
  "version": "0.3.35",
  "slug": "hisense_ac",
  "description": "Fork von deiger/AirCon mit den Fujitsu-Erweiterungen von sarbuk und Verbindungsdiagnose.",
  "url": "https://github.com/Schimmelreiter/AirCon",
  "arch": [
    "armhf",
    "armv7",
    "aarch64",
    "amd64",
    "i386"
  ],
  "startup": "application",
  "boot": "auto",
  "host_network": true,
  "map": [
    "config:rw"
  ],
  "discovery": [
    "mqtt"
  ],
  "services": [
    "mqtt:want"
  ],
  "environment": {
    "CONFIG_DIR": "/config/hisense",
    "OPTIONS_FILE": "/data/options.json"
  },
  "options": {
    "log_level": "INFO",
    "mqtt_host": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_user": null,
    "mqtt_pass": null,
    "port": null
  },
  "schema": {
    "app": [
      {
        "username": "str",
        "password": "str",
        "code": "str"
      }
    ],
    "log_level": "list(CRITICAL|ERROR|WARNING|INFO|DEBUG)?",
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_user": "str?",
    "mqtt_pass": "str?",
    "port": "port",
    "local_ip": "str?",
    "temp_type": "str?"
  }
}
